<resources>
    <style name="TradeText">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#334155</item><item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>
    <style name="TradeHeading" parent="TradeText"><item name="android:textColor">#0F172A</item><item name="android:textSize">16sp</item><item name="android:textStyle">bold</item></style>
    <style name="TradeCard">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item><item name="android:padding">16dp</item>
        <item name="android:layout_marginTop">12dp</item><item name="android:background">@drawable/token_swap_card</item>
    </style>
    <style name="TradeAmount">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">56dp</item>
        <item name="android:inputType">numberDecimal</item><item name="android:singleLine">true</item>
        <item name="android:textSize">24sp</item><item name="android:textColor">#0F172A</item>
        <item name="android:hint">0</item><item name="android:selectAllOnFocus">true</item>
    </style>
    <style name="TradeAction">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">12dp</item><item name="android:background">@drawable/trade_button_busy</item>
        <item name="android:backgroundTint">@null</item><item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item><item name="android:textStyle">bold</item><item name="android:textSize">14sp</item>
        <item name="android:enabled">false</item>
    </style>
    <style name="TradePercent">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item><item name="android:textSize">13sp</item><item name="android:textAllCaps">false</item>
    </style>
</resources>
